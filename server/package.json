{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:tickets": "bun prisma/seed-tickets.ts",
    "db:seed:ai-agent": "bun prisma/seed-ai-agent.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.11",
    "@ai-sdk/google": "^4.0.8",
    "@prisma/client": "^5.0.0",
    "@sendgrid/inbound-mail-parser": "^8.0.0",
    "@sentry/node": "^10.63.0",
    "ai": "^7.0.14",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "prisma": "^5.0.0"
  }
}
